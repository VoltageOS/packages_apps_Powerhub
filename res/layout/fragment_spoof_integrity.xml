<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:theme="@style/Theme.Powerhub.Spoof">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                style="@style/Widget.Powerhub.Spoof.HeroIcon"
                android:layout_width="@dimen/spoof_hero_icon_size"
                android:layout_height="@dimen/spoof_hero_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_powerhub_spoofing_expressive" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.Powerhub.Spoof.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pif_category_title" />

                <TextView
                    android:id="@+id/hero_summary"
                    style="@style/Widget.Powerhub.Spoof.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/status_pill"
                    style="@style/Widget.Powerhub.Spoof.StatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Widget.Powerhub.Spoof.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/spoof_section_profile" />

            <TextView
                android:id="@+id/profile_name"
                style="@style/Widget.Powerhub.Spoof.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profile_model"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/profile_fingerprint"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/profile_patch"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/profile_warning"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/powerhub_spoof_error"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_fetch"
                style="@style/Widget.Powerhub.Spoof.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/spoof_fetch_profile" />

            <ProgressBar
                android:id="@+id/fetch_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import"
                style="@style/Widget.Powerhub.Spoof.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/spoof_import_profile" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_props"
                    style="@style/Widget.Powerhub.Spoof.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spoof_view_properties" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_profile"
                    style="@style/Widget.Powerhub.Spoof.DestructiveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/spoof_delete_profile" />
            </LinearLayout>

            <include
                android:id="@+id/row_pif_presets"
                layout="@layout/row_spoof_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/Widget.Powerhub.Spoof.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/spoof_section_keybox" />

            <TextView
                android:id="@+id/keybox_status"
                style="@style/Widget.Powerhub.Spoof.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/keybox_pill"
                style="@style/Widget.Powerhub.Spoof.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/keybox_detail"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/keybox_algorithms"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/keybox_certificates"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/keybox_validity"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/keybox_expiry_warning"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/powerhub_spoof_error"
                android:visibility="gone" />

            <TextView
                android:id="@+id/keybox_serial"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/keybox_revocation"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/keybox_revocation_warning"
                style="@style/Widget.Powerhub.Spoof.RowSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/powerhub_spoof_error"
                android:visibility="gone" />

            <include
                android:id="@+id/row_keybox_check"
                layout="@layout/row_spoof_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <include
                android:id="@+id/row_keybox_details"
                layout="@layout/row_spoof_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_keybox_import"
                style="@style/Widget.Powerhub.Spoof.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/keybox_import_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_keybox_delete"
                style="@style/Widget.Powerhub.Spoof.DestructiveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/keybox_delete_pref_title" />

            <include
                android:id="@+id/row_patch"
                layout="@layout/row_spoof_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <include
                android:id="@+id/header_options"
                layout="@layout/row_spoof_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/row_photos"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_props"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_build"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_provider"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_signature"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_vending"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <include
                android:id="@+id/header_targets"
                layout="@layout/row_spoof_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/targets_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/target_status"
                    style="@style/Widget.Powerhub.Spoof.RowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/target_distribution"
                    style="@style/Widget.Powerhub.Spoof.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" />

                <include
                    android:id="@+id/row_targets_manage"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <include
                    android:id="@+id/row_targets_import"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_targets_defaults"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <include
                android:id="@+id/header_logging"
                layout="@layout/row_spoof_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/logging_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/row_debug"
                    layout="@layout/row_spoof_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_verbose"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/row_diagnostics"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Powerhub.Spoof.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <include
                android:id="@+id/header_apply"
                layout="@layout/row_spoof_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/apply_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Widget.Powerhub.Spoof.RowSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/spoof_restart_summary" />

                <include
                    android:id="@+id/row_backup"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <include
                    android:id="@+id/row_restore"
                    layout="@layout/row_spoof_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restart"
                    style="@style/Widget.Powerhub.Spoof.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pif_restart_targets_title" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
