<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/Theme.Powerhub.Spoof">

    <LinearLayout
        android:id="@+id/spoof_segments"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/powerhub_spoof_segment_track"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/spoof_segment_integrity"
            style="@style/Widget.Powerhub.Spoof.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/spoof_tab_integrity" />

        <TextView
            android:id="@+id/spoof_segment_per_app"
            style="@style/Widget.Powerhub.Spoof.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/spoof_tab_per_app" />

        <TextView
            android:id="@+id/spoof_segment_hidden"
            style="@style/Widget.Powerhub.Spoof.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/spoof_tab_hidden" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/spoof_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
