<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="pif_active_config"
        android:title="@string/pif_no_config_loaded"
        android:summary="@string/pif_no_props" />

    <Preference
        android:key="pif_fetch_beta"
        android:title="@string/pif_fetch_beta_title" />

    <Preference
        android:key="pif_fetch_voltage"
        android:title="@string/pif_fetch_voltage_title" />

    <Preference
        android:key="pif_import_file"
        android:title="@string/pif_import_title"
        android:summary="@string/pif_import_summary" />

    <Preference
        android:key="pif_show_props"
        android:title="@string/pif_show_props_title"
        android:summary="@string/pif_no_props" />

    <PreferenceCategory
        android:key="pif_options_category"
        android:title="@string/pif_options_category">

        <com.voltage.support.preferences.SecureSettingSwitchPreference
            android:key="spoof_pif_photos"
            android:title="@string/pif_spoof_photos_title"
            android:summary="@string/pif_spoof_photos_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pif_spoof_props"
            android:title="@string/pif_spoof_props_title"
            android:summary="@string/pif_spoof_props_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pif_spoof_provider"
            android:title="@string/pif_spoof_provider_title"
            android:summary="@string/pif_spoof_provider_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="pif_spoof_signature"
            android:title="@string/pif_spoof_signature_title"
            android:summary="@string/pif_spoof_signature_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="pif_spoof_vending_build"
            android:title="@string/pif_spoof_vending_build_title"
            android:summary="@string/pif_spoof_vending_build_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
