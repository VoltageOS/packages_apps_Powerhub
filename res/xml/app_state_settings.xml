<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="app_state_status"
        android:title="@string/app_state_disabled"
        android:summary="@string/app_state_no_apps"
        android:selectable="false" />

    <SwitchPreferenceCompat
        android:key="app_state_enabled"
        android:title="@string/app_state_enabled_title"
        android:summary="@string/app_state_enabled_summary"
        android:defaultValue="false" />

    <Preference
        android:key="app_state_add_app"
        android:title="@string/app_state_add_app"
        android:summary="@string/app_state_add_app_summary" />

    <PreferenceCategory
        android:key="app_state_app_list_category"
        android:title="@string/app_state_configured_apps" />

</PreferenceScreen>
