<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/monet_settings_title"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">
    <!-- Wallpaper Settings -->
    <Preference
       android:key="wallpaper_settings"
       android:title="@string/wallpaper_settings_title"
       android:summary="@string/wallpaper_settings_summary"
       android:icon="@drawable/ic_powerhub_wallpaper_expressive"
       android:fragment="com.power.hub.fragments.Wallpaper" />

    <Preference
        android:key="color_engine_settings"
        android:title="Color Engine"
        android:summary="Palette generation and base colors"
        android:icon="@drawable/ic_powerhub_color_expressive"
        android:fragment="com.power.hub.fragments.ColorEngineSettings" />

    <Preference
        android:key="advanced_color_settings"
        android:title="Advanced Colors"
        android:summary="Luminance, chroma, and surface tinting"
        android:icon="@drawable/ic_powerhub_advancedcolor_expressive"
        android:fragment="com.power.hub.fragments.AdvancedColorSettings" />

    <Preference
        android:key="qs_style_settings"
        android:title="@string/qs_blur_category_title"
        android:summary="Dual-tone, split shade and blur customization"
        android:icon="@drawable/ic_powerhub_qsstyle_expressive"
        android:fragment="com.power.hub.fragments.QuickSettingsStyle" />

</PreferenceScreen>
